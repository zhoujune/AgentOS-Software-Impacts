+def task_proxy_timing_diagnostics(log_path: Path, task_id: str, enqueue_wall_time: float, wait_seconds: float) -> dict[str, Any]:
+    """Extract request/response milestones from the per-case proxy log."""
+    request_pattern = re.compile(
+        rf"^(?P<ts>\d{{4}}-\d{{2}}-\d{{2}} \d{{2}}:\d{{2}}:\d{{2}},\d{{3}}) \[INFO\] Processing request: (?P<id>llm-{re.escape(task_id)}-\d+)$"
+    )
+    response_pattern = re.compile(
+        rf"^(?P<ts>\d{{4}}-\d{{2}}-\d{{2}} \d{{2}}:\d{{2}}:\d{{2}},\d{{3}}) \[INFO\] Response written: .*/(?P<id>llm-{re.escape(task_id)}-\d+)\.json$"
+    )
+    requests: dict[str, float] = {}
+    responses: dict[str, float] = {}
+    try:
+        lines = log_path.read_text(encoding="utf-8", errors="replace").splitlines() if log_path.exists() else []
+    except OSError:
+        lines = []
+    for line in lines:
+        for pattern, bucket in ((request_pattern, requests), (response_pattern, responses)):
+            match = pattern.match(line.strip())
+            if not match:
+                continue
+            event_time = datetime.strptime(match.group("ts"), "%Y-%m-%d %H:%M:%S,%f").timestamp()
+            bucket.setdefault(match.group("id"), event_time)
+    ordered_requests = sorted(requests.items(), key=lambda item: item[1])
+    enqueue_to_first_request = max(0.0, ordered_requests[0][1] - enqueue_wall_time) if ordered_requests else None
+    request_gaps = [round(b[1] - a[1], 6) for a, b in zip(ordered_requests, ordered_requests[1:])]
+    response_latencies = [round(responses[rid] - started, 6) for rid, started in ordered_requests if rid in responses]
+    last_response_time = max(responses.values()) if responses else None
+    response_to_result = max(0.0, wait_seconds - (last_response_time - enqueue_wall_time)) if last_response_time else None
+    return {
+        "first_proxy_request_after_enqueue_seconds": round(enqueue_to_first_request, 6) if enqueue_to_first_request is not None else None,
+        "proxy_request_count": len(requests),
+        "proxy_response_count": len(responses),
+        "proxy_request_start_gaps_seconds": request_gaps,
+        "proxy_request_response_latencies_seconds": response_latencies,
+        "last_proxy_response_to_task_result_seconds": round(response_to_result, 6) if response_to_result is not None else None,
+    }
