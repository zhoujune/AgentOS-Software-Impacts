@@ -0,0 +1,63 @@
+"""Unit tests for repeated benchmark timing aggregation helpers."""
+from __future__ import annotations
+
+import sys
+import unittest
+from pathlib import Path
+
+sys.path.insert(0, str(Path(__file__).resolve().parent))
+from aggregate_repeated_benchmark import PHASES, percentile, stats
+from run_vtrm_eval import task_proxy_timing_diagnostics
+
+
+class BenchmarkTimingTests(unittest.TestCase):
+    def test_nearest_rank_percentile(self) -> None:
+        self.assertEqual(percentile([1.0, 2.0, 3.0, 4.0], 0.95), 4.0)
+        self.assertEqual(percentile([7.0], 0.95), 7.0)
+        self.assertIsNone(percentile([], 0.95))
+
+    def test_stats_reports_distribution_and_unit(self) -> None:
+        summary = stats([1.0, 2.0, 3.0, 4.0], "seconds")
+        self.assertEqual(summary["sample_count"], 4)
+        self.assertEqual(summary["mean"], 2.5)
+        self.assertEqual(summary["median"], 2.5)
+        self.assertEqual(summary["p95"], 4.0)
+        self.assertEqual(summary["unit"], "seconds")
+
+    def test_proxy_log_diagnostics_deduplicate_duplicate_handlers(self) -> None:
+        from datetime import datetime
+        from pathlib import Path
+        from tempfile import TemporaryDirectory
+
+        with TemporaryDirectory() as tmp:
+            log_path = Path(tmp) / "llm_proxy.log"
+            log_path.write_text(
+                "2026-10-29 09:43:43,017 [INFO] Processing request: llm-unit-task-001\n"
+                "2026-10-29 09:43:43,017 [INFO] Processing request: llm-unit-task-001\n"
+                "2026-10-29 09:43:43,018 [INFO] Response written: /tmp/inbox/llm-unit-task-001.json\n"
+                "2026-10-29 09:43:45,018 [INFO] Processing request: llm-unit-task-002\n"
+                "2026-10-29 09:43:45,019 [INFO] Response written: /tmp/inbox/llm-unit-task-002.json\n",
+                encoding="utf-8",
+            )
+            first_event = datetime.strptime("2026-10-29 09:43:43,017", "%Y-%m-%d %H:%M:%S,%f").timestamp()
+            diag = task_proxy_timing_diagnostics(log_path, "unit-task", first_event - 1.0, 4.0)
+            self.assertEqual(diag["proxy_request_count"], 2)
+            self.assertEqual(diag["proxy_response_count"], 2)
+            self.assertAlmostEqual(diag["first_proxy_request_after_enqueue_seconds"], 1.0, places=3)
+            self.assertAlmostEqual(diag["proxy_request_start_gaps_seconds"][0], 2.001, places=3)
+            self.assertAlmostEqual(diag["proxy_request_response_latencies_seconds"][0], 0.001, places=3)
+
+    def test_required_system_phases_are_included(self) -> None:
+        for phase in (
+            "qemu_launch_seconds",
+            "vm_boot_to_ready_seconds",
+            "guest_agent_bootstrap_seconds",
+            "image_reset_seconds",
+            "task_enqueue_and_wait_seconds",
+            "case_runtime_including_reset_seconds",
+        ):
+            self.assertIn(phase, PHASES)
+
+
+if __name__ == "__main__":
+    unittest.main()
