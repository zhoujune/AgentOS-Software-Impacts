+def load_replay_cassette(path: str | Path) -> dict[str, dict[str, str]]:
+    """Load a versioned, request-id-keyed cassette for deterministic replay."""
+    cassette_path = Path(path)
+    try:
+        payload = json.loads(cassette_path.read_text(encoding="utf-8"))
+    except (OSError, json.JSONDecodeError) as exc:
+        raise ValueError(f"cannot read replay cassette {cassette_path}: {exc}") from exc
+    if not isinstance(payload, dict) or payload.get("format_version") != 1:
+        raise ValueError("replay cassette must be a JSON object with format_version=1")
+    responses = payload.get("responses")
+    if not isinstance(responses, dict) or not responses:
+        raise ValueError("replay cassette must contain a non-empty 'responses' object")
+    normalized: dict[str, dict[str, str]] = {}
+    for request_id, response in responses.items():
+        if not isinstance(request_id, str) or not request_id.strip():
+            raise ValueError("replay cassette response keys must be non-empty request IDs")
+        if not isinstance(response, dict) or not isinstance(response.get("assistant_text"), str):
+            raise ValueError(f"replay response {request_id!r} must contain string assistant_text")
+        finish_reason = response.get("finish_reason", "stop")
+        if not isinstance(finish_reason, str):
+            raise ValueError(f"replay response {request_id!r} finish_reason must be a string")
+        normalized[request_id] = {"assistant_text": response["assistant_text"], "finish_reason": finish_reason}
+    return normalized
 
 
