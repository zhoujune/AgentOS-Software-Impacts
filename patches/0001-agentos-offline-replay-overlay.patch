+def validate_replay_cassette(path: Path) -> dict[str, Any]:
+    payload = load_json(path)
+    if not isinstance(payload, dict) or payload.get("format_version") != 1:
+        raise ValueError("cassette must be a JSON object with format_version=1")
+    responses = payload.get("responses")
+    if not isinstance(responses, dict) or not responses:
+        raise ValueError("cassette must contain a non-empty 'responses' object")
+    for request_id, response in responses.items():
+        if not isinstance(request_id, str) or not request_id.strip():
+            raise ValueError("cassette response keys must be non-empty request IDs")
+        if not isinstance(response, dict) or not isinstance(response.get("assistant_text"), str):
+            raise ValueError(f"cassette response {request_id!r} must contain string assistant_text")
+        if not isinstance(response.get("finish_reason", "stop"), str):
