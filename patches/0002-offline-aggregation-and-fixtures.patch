diff --git a/judge/aggregate_repeated_benchmark.py b/judge/aggregate_repeated_benchmark.py
new file mode 100644
index 0000000..c11c0087a91fa503dcf580c1fd2f4e0a55da8634
--- /dev/null
+++ b/judge/aggregate_repeated_benchmark.py
@@ -0,0 +1,298 @@
+#!/usr/bin/env python3
+"""Aggregate validated repeated offline AgentOS benchmark runs."""
+from __future__ import annotations
+
+import argparse
+import json
+import math
+import statistics
+from datetime import datetime
+from pathlib import Path
+from typing import Any
+
+PHASES = [
+    "qemu_launch_seconds",
+    "vm_boot_to_ready_seconds",
+    "guest_agent_bootstrap_seconds",
+    "proxy_startup_and_warmup_seconds",
+    "before_snapshot_seconds",
+    "task_enqueue_and_wait_seconds",
+    "sync_and_settle_seconds",
+    "process_shutdown_seconds",
+    "after_snapshot_seconds",
+    "world_diff_and_evaluation_seconds",
+    "case_runtime_excluding_reset_seconds",
+    "image_reset_seconds",
+    "case_runtime_including_reset_seconds",
+]
+
+
+def read_json(path: Path) -> dict[str, Any]:
+    return json.loads(path.read_text(encoding="utf-8"))
+
+
+def percentile(values: list[float], pct: float) -> float | None:
+    if not values:
+        return None
+    ordered = sorted(values)
+    return ordered[max(0, math.ceil(pct * len(ordered)) - 1)]
+
+
+def stats(values: list[float], unit: str) -> dict[str, Any]:
+    return {
+        "unit": unit,
+        "sample_count": len(values),
+        "mean": round(statistics.mean(values), 6) if values else None,
+        "median": round(statistics.median(values), 6) if values else None,
+        "p95": round(percentile(values, 0.95), 6) if values else None,
+        "min": round(min(values), 6) if values else None,
+        "max": round(max(values), 6) if values else None,
+    }
+
+
+def main() -> int:
+    parser = argparse.ArgumentParser()
+    parser.add_argument("--study-root", type=Path, required=True)
+    parser.add_argument("--expected-repetitions", type=int, required=True)
+    args = parser.parse_args()
+    root = args.study_root.resolve()
+    errors: list[str] = []
+    repetitions: list[dict[str, Any]] = []
+    phase_values: dict[str, list[float]] = {phase: [] for phase in PHASES}
+    cassette_hashes: set[str] = set()
+    initial_copy_values: list[float] = []
+    vtrm_values: list[float] = []
+    first_request_values: list[float] = []
+    inter_request_gap_values: list[float] = []
+    proxy_response_latency_values: list[float] = []
+    response_to_result_values: list[float] = []
+    suite_durations: list[float] = []
+    case_runtime_values: list[float] = []
+    case_runtime_sum_values: list[float] = []
+    all_case_rows: list[dict[str, Any]] = []
+
+    for index in range(1, args.expected_repetitions + 1):
+        run_name = f"run-{index:02d}"
+        report_path = root / run_name / "offline_benchmark.json"
+        if not report_path.is_file():
+            errors.append(f"{run_name}: missing offline_benchmark.json")
+            continue
+        report = read_json(report_path)
+        if report.get("all_ok") is not True:
+            errors.append(f"{run_name}: individual benchmark validation failed: {report.get('errors', [])}")
+        if report.get("representative_task_count") != 6:
+            errors.append(f"{run_name}: expected six tasks, got {report.get('representative_task_count')}")
+        if set(report.get("suites", {})) != {"benign", "denials"}:
+            errors.append(f"{run_name}: expected benign and denials suites")
+        if isinstance(report.get("cassette_sha256"), str):
+            cassette_hashes.add(report["cassette_sha256"])
+        rep_phase: dict[str, list[float]] = {phase: [] for phase in PHASES}
+        rep_copy: list[float] = []
+        rep_vtrm: list[float] = []
+        rep_suite_duration = 0.0
+        rep_case_duration = 0.0
+        for suite_name, suite in report.get("suites", {}).items():
+            if suite.get("all_ok") is not True or suite.get("replay_ok") is not True:
+                errors.append(f"{run_name}/{suite_name}: suite result failed")
+            if suite.get("guest_network_enabled") is not False:
+                errors.append(f"{run_name}/{suite_name}: guest networking was enabled")
+            suite_dur = suite.get("suite_duration_seconds")
+            if isinstance(suite_dur, (int, float)) and suite_dur >= 0:
+                rep_suite_duration += float(suite_dur)
+            copy_seconds = suite.get("initial_rootfs_copy_seconds")
+            if isinstance(copy_seconds, (int, float)) and copy_seconds >= 0:
+                rep_copy.append(float(copy_seconds))
+                initial_copy_values.append(float(copy_seconds))
+            for case in suite.get("cases", []):
+                timings = case.get("timings", {})
+                task_id = case.get("task_id")
+                for phase in PHASES:
+                    value = timings.get(phase)
+                    if isinstance(value, (int, float)) and value >= 0:
+                        rep_phase[phase].append(float(value))
+                        phase_values[phase].append(float(value))
+                vtrm_mean = case.get("vtrm_operation_mean_ms")
+                wait_diag = case.get("task_wait_diagnostics", {})
+                first_request = wait_diag.get("first_proxy_request_after_enqueue_seconds")
+                if isinstance(first_request, (int, float)) and first_request >= 0:
+                    first_request_values.append(float(first_request))
+                for gap in wait_diag.get("proxy_request_start_gaps_seconds", []):
+                    if isinstance(gap, (int, float)) and gap >= 0:
+                        inter_request_gap_values.append(float(gap))
+                for latency in wait_diag.get("proxy_request_response_latencies_seconds", []):
+                    if isinstance(latency, (int, float)) and latency >= 0:
+                        proxy_response_latency_values.append(float(latency))
+                response_to_result = wait_diag.get("last_proxy_response_to_task_result_seconds")
+                if isinstance(response_to_result, (int, float)) and response_to_result >= 0:
+                    response_to_result_values.append(float(response_to_result))
+                case_duration = timings.get("case_runtime_including_reset_seconds")
+                if isinstance(case_duration, (int, float)) and case_duration >= 0:
+                    rep_case_duration += float(case_duration)
+                    case_runtime_values.append(float(case_duration))
+                all_case_rows.append({
+                    "repetition": index,
+                    "suite": suite_name,
+                    "task_id": task_id,
+                    "vm_boot_to_ready_seconds": timings.get("vm_boot_to_ready_seconds"),
+                    "guest_agent_bootstrap_seconds": timings.get("guest_agent_bootstrap_seconds"),
+                    "image_reset_seconds": timings.get("image_reset_seconds"),
+                    "case_runtime_including_reset_seconds": case_duration,
+                    "task_wait_diagnostics": wait_diag,
+                    "vtrm_operation_count": case.get("vtrm_operation_count", 0),
+                    "vtrm_operation_mean_ms": vtrm_mean,
+                    "vtrm_operation_max_ms": case.get("vtrm_operation_max_ms"),
+                })
+        for event in report.get("vtrm_operation_records", []):
+            elapsed = event.get("execution_time_ms")
+            if isinstance(elapsed, (int, float)) and elapsed >= 0:
+                rep_vtrm.append(float(elapsed))
+                vtrm_values.append(float(elapsed))
+        suite_durations.append(rep_suite_duration)
+        case_runtime_sum_values.append(rep_case_duration)
+        repetitions.append({
+            "repetition": index,
+            "run_root": str(root / run_name),
+            "all_ok": report.get("all_ok"),
+            "suite_duration_seconds_sum": round(rep_suite_duration, 6),
+            "case_runtime_seconds_sum_including_resets": round(rep_case_duration, 6),
+            "initial_rootfs_copy_seconds": rep_copy,
+            "phase_timing_summary": {phase: stats(values, "seconds") for phase, values in rep_phase.items()},
+            "vtrm_operation_timing": stats(rep_vtrm, "milliseconds"),
+        })
+
+    if len(repetitions) != args.expected_repetitions:
+        errors.append(f"found {len(repetitions)} valid repetition reports, expected {args.expected_repetitions}")
+    if len(cassette_hashes) > 1:
+        errors.append(f"cassette hash changed across repetitions: {sorted(cassette_hashes)}")
+
+    phase_summary = {phase: stats(values, "seconds") for phase, values in phase_values.items()}
+    vtrm_summary = stats(vtrm_values, "milliseconds")
+    task_wait_diagnostics_summary = {
+        "first_proxy_request_after_enqueue_seconds": stats(first_request_values, "seconds"),
+        "proxy_request_start_gap_seconds": stats(inter_request_gap_values, "seconds"),
+        "proxy_request_response_latency_seconds": stats(proxy_response_latency_values, "seconds"),
+        "last_proxy_response_to_task_result_seconds": stats(response_to_result_values, "seconds"),
+    }
+    initial_copy_summary = stats(initial_copy_values, "seconds")
+    suite_duration_summary = stats(suite_durations, "seconds")
+    case_runtime_summary = stats(case_runtime_values, "seconds")
+    case_runtime_sum_summary = stats(case_runtime_sum_values, "seconds")
+    environment_path = root / "study_environment.json"
+    environment = read_json(environment_path) if environment_path.is_file() else {}
+    environment_cassette_hash = environment.get("cassette_sha256")
+    if environment_cassette_hash and cassette_hashes and environment_cassette_hash not in cassette_hashes:
+        errors.append("cassette hash in environment manifest does not match repetition reports")
+    report = {
+        "format_version": 1,
+        "created_at": datetime.now().astimezone().isoformat(),
+        "study_root": str(root),
+        "environment": environment,
+        "expected_repetitions": args.expected_repetitions,
+        "completed_repetitions": len(repetitions),
+        "task_count_per_repetition": 6,
+        "all_ok": not errors,
+        "errors": errors,
+        "repetitions": repetitions,
+        "initial_rootfs_copy_timing": initial_copy_summary,
+        "phase_timing_summary": phase_summary,
+        "vtrm_terminal_operation_timing": vtrm_summary,
+        "task_wait_diagnostics_summary": task_wait_diagnostics_summary,
+        "suite_duration_sum_per_repetition": suite_duration_summary,
+        "case_runtime_per_case_including_resets": case_runtime_summary,
+        "case_runtime_sum_per_repetition_including_resets": case_runtime_sum_summary,
+        "case_records": all_case_rows,
+        "interpretation": {
+            "vm_boot_to_ready_seconds": "QEMU launch has completed; time spent waiting for a configured guest-ready log phrase. Polling resolution is approximately one second.",
+            "image_reset_seconds": "Time to copy the clean rootfs to the runtime rootfs between cases; initial rootfs copies are summarized separately.",
+            "vtrm_terminal_operation_timing": "execution_time_ms from terminal VTRM audit events; excludes model inference, QEMU boot, and full end-to-end task latency.",
+            "task_enqueue_and_wait_seconds": "Agent task lifecycle wait under deterministic replay; not model inference latency.",
+            "repeatability": "Percentiles summarize the observed samples only. With few repetitions these are descriptive, not confidence bounds.",
+            "host_cache": "No host page-cache flush is performed; sequential repetitions may benefit from warm filesystem caches.",
+        },
+    }
+    json_path = root / "repeated_benchmark.json"
+    json_path.write_text(json.dumps(report, indent=2, ensure_ascii=False) + "\n", encoding="utf-8")
+
+    lines = [
+        "# Repeated offline AgentOS performance study",
+        "",
+        f"- Overall validation: **{'PASS' if not errors else 'FAIL'}**",
+        f"- Repetitions: {len(repetitions)}/{args.expected_repetitions}",
+        f"- Tasks: {6 * len(repetitions)} total task-runs; six per repetition",
+        "- Guest networking: disabled; model API calls: none",
+        f"- Cassette SHA-256 consistency: {'PASS' if len(cassette_hashes) == 1 else 'FAIL'}",
+        f"- Environment manifest: `{environment_path}`",
+        "",
+        "## Main timing distributions",
+        "",
+        "| Metric | Samples | Mean | Median | P95 | Min | Max | Unit |",
+        "|---|---:|---:|---:|---:|---:|---:|---|",
+    ]
+    summary_rows = [
+        ("Initial clean-image copy", initial_copy_summary),
+        ("QEMU launch", phase_summary["qemu_launch_seconds"]),
+        ("VM boot to ready phrase", phase_summary["vm_boot_to_ready_seconds"]),
+        ("Guest-agent bootstrap", phase_summary["guest_agent_bootstrap_seconds"]),
+        ("Image reset between cases", phase_summary["image_reset_seconds"]),
+        ("Task enqueue + wait", phase_summary["task_enqueue_and_wait_seconds"]),
+        ("Case runtime including reset", phase_summary["case_runtime_including_reset_seconds"]),
+        ("VTRM terminal operation", vtrm_summary),
+        ("Enqueue to first proxy request", task_wait_diagnostics_summary["first_proxy_request_after_enqueue_seconds"]),
+        ("Proxy request start gap", task_wait_diagnostics_summary["proxy_request_start_gap_seconds"]),
+        ("Proxy request/response log interval", task_wait_diagnostics_summary["proxy_request_response_latency_seconds"]),
+        ("Last proxy response to task result", task_wait_diagnostics_summary["last_proxy_response_to_task_result_seconds"]),
+        ("Two-suite duration sum / repetition", suite_duration_summary),
+        ("Case-runtime sum / repetition", case_runtime_sum_summary),
+    ]
+    for name, value in summary_rows:
+        lines.append(
+            f"| {name} | {value['sample_count']} | {value['mean']} | {value['median']} | "
+            f"{value['p95']} | {value['min']} | {value['max']} | {value['unit']} |"
+        )
+    lines.extend([
+        "",
+        "## Per-repetition summary",
+        "",
+        "| Repetition | Validation | Suite duration sum (s) | Case runtime sum incl. resets (s) | VTRM samples | VTRM median (ms) | VTRM P95 (ms) |",
+        "|---:|---|---:|---:|---:|---:|---:|",
+    ])
+    for rep in repetitions:
+        vt = rep["vtrm_operation_timing"]
+        lines.append(
+            f"| {rep['repetition']} | {'PASS' if rep['all_ok'] else 'FAIL'} | "
+            f"{rep['suite_duration_seconds_sum']} | {rep['case_runtime_seconds_sum_including_resets']} | "
+            f"{vt['sample_count']} | {vt['median']} | {vt['p95']} |"
+        )
+    lines.extend([
+        "",
+        "## Interpretation notes",
+        "",
+        "- VM boot-to-ready uses a one-second log polling interval, so small differences below that scale should not be overinterpreted.",
+        "- Image reset is measured separately from VM boot and includes copy-on-write/reflink behavior where supported by the filesystem.",
+        "- Host page cache is not flushed between repetitions; later runs may benefit from warm filesystem caches.",
+        "- VTRM timings are tool/audit execution only; they do not measure the full agent loop or model inference.",
+        "- Repeated samples are descriptive. Increase repetitions and report environment details for a formal performance comparison.",
+        "",
+    ])
+    if errors:
+        lines.extend(["## Validation failures", ""])
+        lines.extend(f"- {error}" for error in errors)
+        lines.append("")
+    md_path = root / "repeated_benchmark.md"
+    md_path.write_text("\n".join(lines), encoding="utf-8")
+    print(json.dumps({
+        "all_ok": report["all_ok"],
+        "completed_repetitions": len(repetitions),
+        "expected_repetitions": args.expected_repetitions,
+        "vm_boot_median_seconds": phase_summary["vm_boot_to_ready_seconds"]["median"],
+        "image_reset_median_seconds": phase_summary["image_reset_seconds"]["median"],
+        "vtrm_median_ms": vtrm_summary["median"],
+        "report_json": str(json_path),
+        "report_markdown": str(md_path),
+        "errors": errors,
+    }, indent=2))
+    return 0 if not errors else 1
+
+
+if __name__ == "__main__":
+    raise SystemExit(main())
